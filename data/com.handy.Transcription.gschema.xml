<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <enum id="com.handy.Transcription.LogLevel">
    <value nick="trace" value="0"/>
    <value nick="debug" value="1"/>
    <value nick="info" value="2"/>
    <value nick="warn" value="3"/>
    <value nick="error" value="4"/>
  </enum>
  
  <enum id="com.handy.Transcription.SoundTheme">
    <value nick="marimba" value="0"/>
    <value nick="pop" value="1"/>
    <value nick="custom" value="2"/>
  </enum>
  
  <enum id="com.handy.Transcription.ModelUnloadTimeout">
    <value nick="never" value="0"/>
    <value nick="immediately" value="1"/>
    <value nick="min2" value="2"/>
    <value nick="min5" value="3"/>
    <value nick="min10" value="4"/>
    <value nick="min15" value="5"/>
    <value nick="hour1" value="6"/>
    <value nick="sec5" value="7"/>
  </enum>
  
  <enum id="com.handy.Transcription.PasteMethod">
    <value nick="ctrl-v" value="0"/>
    <value nick="direct" value="1"/>
    <value nick="none" value="2"/>
    <value nick="shift-insert" value="3"/>
    <value nick="ctrl-shift-v" value="4"/>
  </enum>
  
  <enum id="com.handy.Transcription.ClipboardHandling">
    <value nick="dont-modify" value="0"/>
    <value nick="copy-to-clipboard" value="1"/>
  </enum>
  
  <enum id="com.handy.Transcription.AutoSubmitKey">
    <value nick="enter" value="0"/>
    <value nick="ctrl-enter" value="1"/>
    <value nick="cmd-enter" value="2"/>
  </enum>
  
  <enum id="com.handy.Transcription.RecordingRetentionPeriod">
    <value nick="never" value="0"/>
    <value nick="preserve-limit" value="1"/>
    <value nick="days3" value="2"/>
    <value nick="weeks2" value="3"/>
    <value nick="months3" value="4"/>
  </enum>
  
  <enum id="com.handy.Transcription.TypingTool">
    <value nick="auto" value="0"/>
    <value nick="wtype" value="1"/>
    <value nick="kwtype" value="2"/>
    <value nick="dotool" value="3"/>
    <value nick="ydotool" value="4"/>
    <value nick="xdotool" value="5"/>
  </enum>

  <schema id="com.handy.Transcription" path="/com/handy/Transcription/">
    <!-- Bindings (stored as JSON) -->
    <key name="bindings" type="s">
      <default>'{"transcribe":{"id":"transcribe","name":"Transcribe","description":"Converts your speech into text.","default_binding":"ctrl+space","current_binding":"ctrl+space"},"transcribe_with_post_process":{"id":"transcribe_with_post_process","name":"Transcribe with Post-Processing","description":"Converts your speech into text and applies AI post-processing.","default_binding":"ctrl+shift+space","current_binding":"ctrl+shift+space"},"cancel":{"id":"cancel","name":"Cancel","description":"Cancels the current recording.","default_binding":"escape","current_binding":"escape"}}'</default>
      <summary>Keyboard shortcut bindings</summary>
    </key>
    
    <!-- General Settings -->
    <key name="push-to-talk" type="b">
      <default>true</default>
      <summary>Push to talk mode</summary>
    </key>
    
    <key name="audio-feedback" type="b">
      <default>false</default>
      <summary>Play audio feedback on start/stop</summary>
    </key>
    
    <key name="audio-feedback-volume" type="d">
      <default>1.0</default>
      <range min="0.0" max="1.0"/>
      <summary>Audio feedback volume</summary>
    </key>
    
    <key name="sound-theme" enum="com.handy.Transcription.SoundTheme">
      <default>'marimba'</default>
      <summary>Sound theme for audio feedback</summary>
    </key>
    
    <key name="selected-microphone" type="s">
      <default>''</default>
      <summary>Selected microphone device</summary>
    </key>
    
    <key name="selected-output-device" type="s">
      <default>''</default>
      <summary>Selected output device for audio feedback</summary>
    </key>
    
    <key name="selected-language" type="s">
      <default>'auto'</default>
      <summary>Selected transcription language</summary>
    </key>
    
    <key name="translate-to-english" type="b">
      <default>false</default>
      <summary>Translate transcriptions to English</summary>
    </key>
    
    <key name="mute-while-recording" type="b">
      <default>false</default>
      <summary>Mute system audio while recording</summary>
    </key>
    
    <!-- Model Settings -->
    <key name="selected-model" type="s">
      <default>''</default>
      <summary>Selected transcription model</summary>
    </key>
    
    <key name="model-unload-timeout" enum="com.handy.Transcription.ModelUnloadTimeout">
      <default>'never'</default>
      <summary>Time to keep model loaded in memory</summary>
    </key>
    
    <!-- App Behavior -->
    <key name="start-hidden" type="b">
      <default>true</default>
      <summary>Start application hidden</summary>
    </key>
    
    <key name="autostart-enabled" type="b">
      <default>true</default>
      <summary>Start automatically on login</summary>
    </key>
    
    <key name="show-tray-icon" type="b">
      <default>true</default>
      <summary>Show system tray icon</summary>
    </key>
    
    <key name="update-checks-enabled" type="b">
      <default>true</default>
      <summary>Check for updates automatically</summary>
    </key>
    
    <!-- Advanced Settings -->
    <key name="paste-method" enum="com.handy.Transcription.PasteMethod">
      <default>'direct'</default>
      <summary>Method for pasting transcribed text</summary>
    </key>
    
    <key name="clipboard-handling" enum="com.handy.Transcription.ClipboardHandling">
      <default>'dont-modify'</default>
      <summary>How to handle clipboard</summary>
    </key>
    
    <key name="auto-submit" type="b">
      <default>false</default>
      <summary>Auto submit after transcription</summary>
    </key>
    
    <key name="auto-submit-key" enum="com.handy.Transcription.AutoSubmitKey">
      <default>'enter'</default>
      <summary>Key to press for auto submit</summary>
    </key>
    
    <key name="paste-delay-ms" type="u">
      <default>60</default>
      <summary>Delay before pasting in milliseconds</summary>
    </key>
    
    <key name="append-trailing-space" type="b">
      <default>false</default>
      <summary>Append space after transcription</summary>
    </key>
    
    <key name="typing-tool" enum="com.handy.Transcription.TypingTool">
      <default>'auto'</default>
      <summary>Tool to use for typing text</summary>
    </key>
    
    <key name="custom-words" type="as">
      <default>[]</default>
      <summary>Custom words for transcription</summary>
    </key>
    
    <!-- History Settings -->
    <key name="history-limit" type="u">
      <default>5</default>
      <summary>Maximum number of history entries</summary>
    </key>
    
    <key name="recording-retention-period" enum="com.handy.Transcription.RecordingRetentionPeriod">
      <default>'preserve-limit'</default>
      <summary>How long to keep recordings</summary>
    </key>
    
    <!-- Debug Settings -->
    <key name="debug-mode" type="b">
      <default>false</default>
      <summary>Enable debug mode</summary>
    </key>
    
    <key name="log-level" enum="com.handy.Transcription.LogLevel">
      <default>'debug'</default>
      <summary>Logging verbosity level</summary>
    </key>
    
    <key name="word-correction-threshold" type="d">
      <default>0.18</default>
      <range min="0.0" max="1.0"/>
      <summary>Threshold for word correction</summary>
    </key>
    
    <key name="always-on-microphone" type="b">
      <default>false</default>
      <summary>Keep microphone always on (debug)</summary>
    </key>
    
    <key name="experimental-enabled" type="b">
      <default>false</default>
      <summary>Enable experimental features</summary>
    </key>
    
    <!-- Post-Processing Settings -->
    <key name="post-process-enabled" type="b">
      <default>false</default>
      <summary>Enable AI post-processing</summary>
    </key>
    
    <key name="post-process-provider-id" type="s">
      <default>'openai'</default>
      <summary>Active post-processing provider</summary>
    </key>
    
    <key name="post-process-api-keys" type="s">
      <default>'{}'</default>
      <summary>API keys for providers (JSON)</summary>
    </key>
    
    <key name="post-process-models" type="s">
      <default>'{}'</default>
      <summary>Selected models for providers (JSON)</summary>
    </key>
    
    <key name="post-process-base-urls" type="s">
      <default>'{}'</default>
      <summary>Custom base URLs for providers (JSON)</summary>
    </key>
    
    <key name="post-process-prompts" type="s">
      <default>'[{"id":"default_improve_transcriptions","name":"Improve Transcriptions","prompt":"Clean this transcript:\n1. Fix spelling, capitalization, and punctuation errors\n2. Convert number words to digits (twenty-five → 25, ten percent → 10%, five dollars → $5)\n3. Replace spoken punctuation with symbols (period → ., comma → ,, question mark → ?)\n4. Remove filler words (um, uh, like as filler)\n5. Keep the language in the original version (if it was french, keep it in french for example)\n\nPreserve exact meaning and word order. Do not paraphrase or reorder content.\n\nReturn only the cleaned transcript.\n\nTranscript:\n${output}"}]'</default>
      <summary>Post-processing prompts (JSON)</summary>
    </key>
    
    <key name="post-process-selected-prompt-id" type="s">
      <default>''</default>
      <summary>Selected post-processing prompt ID</summary>
    </key>
    
    <!-- UI Settings -->
    <key name="app-language" type="s">
      <default>'en'</default>
      <summary>Application language</summary>
    </key>
  </schema>
</schemalist>
